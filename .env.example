# Copy to .env next to compose.yaml (chmod 600). HUB_URL, GITLAB_URL, GITLAB_TOKEN and HOOK_SECRET get you going.

# The hub's own address, as people type it (must match the NAS certificate's hostname).
HUB_URL=https://your-nas.example.org:4300
# Shown at the top right of the hub page, e.g. "Example Lab, Berlin". Optional.
HUB_ORG=
# Port on the NAS. Default 4300.
#HUB_PORT=4300
# Keeps people signed in across hub restarts: openssl rand -hex 32
SESSION_SECRET=

# Sign-in with NAS accounts (DSM SSO Server, OIDC application). README step 5.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Or, without SSO: one shared password.
HUB_PASSWORD=

# Your GitLab, e.g. https://gitlab.com or https://your-nas:1234.
GITLAB_URL=
# Lets the builder read the pushed code: a personal access token with read_api and read_repository,
# from an account that can see every site repo (on your own GitLab: an admin). README step 2.
GITLAB_TOKEN=
# Shared with GitLab's push hook (its "Secret token"): openssl rand -hex 32. README step 2.
HOOK_SECRET=

# Remove button (GitLab OAuth application, scope api). README step 5.
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
